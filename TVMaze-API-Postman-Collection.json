    {
      "name": "Flujo Integrado (End-to-End)",
      "description": "Escenarios de flujo completo que combinan los tres endpoints para verificar la integración",
      "item": [
        {
          "name": "E2E 1 - Buscar show (sin comentarios)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{BASE_URL}}/api/search?search_query=lost",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "search"],
              "query": [{"key": "search_query", "value": "lost"}]
            },
            "description": "Paso 1: Buscar shows de 'lost'. Los comentarios deben estar vacíos si es la primera vez."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Búsqueda exitosa', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.length > 0) {",
                  "    pm.environment.set('LOST_SHOW_ID', jsonData[0].id);",
                  "    console.log('Show ID guardado: ' + jsonData[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "E2E 2 - Agregar comentario al show encontrado",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Accept", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"show_id\": {{LOST_SHOW_ID}},\n  \"comment\": \"Serie increíble, el final fue controversia pero la disfruté mucho.\",\n  \"rating\": 4\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{BASE_URL}}/api/comments",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "comments"]
            },
            "description": "Paso 2: Agrega un comentario al primer show encontrado en E2E 1. Usa la variable `LOST_SHOW_ID` guardada automáticamente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Comentario guardado', function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E2E 3 - Volver a buscar (ahora con comentarios)",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{BASE_URL}}/api/search?search_query=lost",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "search"],
              "query": [{"key": "search_query", "value": "lost"}]
            },
            "description": "Paso 3: Vuelve a buscar 'lost'. Ahora el primer show debe tener el comentario guardado en el paso E2E 2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Búsqueda exitosa', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('El primer show tiene comentarios', function () {",
                  "    var jsonData = pm.response.json();",
                  "    var lostShowId = pm.environment.get('LOST_SHOW_ID');",
                  "    var lostShow = jsonData.find(function(s) { return s.id == lostShowId; });",
                  "    if (lostShow) {",
                  "        pm.expect(lostShow.comments).to.be.an('array').that.is.not.empty;",
                  "        pm.expect(lostShow.comments[0]).to.have.property('comment');",
                  "        pm.expect(lostShow.comments[0]).to.have.property('rating');",
                  "        console.log('Comentarios encontrados: ' + JSON.stringify(lostShow.comments));",
                  "    }",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E2E 4 - Obtener detalle del show con comentarios",
          "request": {
            "method": "GET",
            "header": [{"key": "Accept", "value": "application/json"}],
            "url": {
              "raw": "{{BASE_URL}}/api/shows/{{LOST_SHOW_ID}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "shows", "{{LOST_SHOW_ID}}"]
            },
            "description": "Paso 4: Obtiene el detalle del show por ID. Debe incluir el comentario guardado en E2E 2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Detalle del show OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
